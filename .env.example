# 복사해서 .env로 쓰세요: cp .env.example .env
# .env는 gitignore됨 — 절대 커밋 금지. 키는 서버(api)에서만 사용.

# 런타임 채점 (Gemini) — runtime-grading.md
GEMINI_API_KEY=
GRADER_MODEL=gemini-3.1-flash-lite
GRADER_TIMEOUT_MS=4000

# 인증 (구글 OAuth + JWT) — auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
JWT_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:5173

# 인프라 (docker-compose가 컨테이너에 주입; 아래 값은 로컬 직접 실행용)
MONGO_URL=mongodb://localhost:27017/study
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PORT=8787

# 프론트 → 백 API 주소
VITE_API_URL=http://localhost:8787
